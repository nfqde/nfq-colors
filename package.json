{
  "name": "@nfq/colors",
  "description": "",
  "author": ".NFQ | Christoph Kruppe",
  "version": "3.0.2",
  "keywords": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nfqde/nfq-colors.git"
  },
  "bugs": {
    "url": "https://github.com/nfqde/nfq-colors/issues"
  },
  "homepage": "https://github.com/nfqde/nfq-colors#readme",
  "template": {
    "version": "1.2.1",
    "name": "nfq-npm-modules-template",
    "path": "https://github.com/nfqde/nfq-npm-modules-template.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "types": "./types/index.d.ts"
    },
    "./cypress": {
      "import": {
        "default": "./dist/cypress/esm/commands.js",
        "types": "./dist/cypress/types/index.d.ts"
      },
      "require": {
        "default": "./dist/cypress/commands.js",
        "types": "./dist/cypress/types/index.d.ts"
      }
    }
  },
  "sideEffects": [
    "cypress/**",
    "dist/cypress/**"
  ],
  "scripts": {
    "build": "rollup -c && pnpm tsc",
    "watch": "rollup -c -w",
    "deploy": "standard-version && git push --follow-tags origin main && pnpm publish",
    "check:types": "tsc -p .",
    "lint": "pnpm eslint ./src --ext='.js' --ext='.jsx' --ext='.ts' --ext='.tsx'",
    "lint:report": "pnpm eslint --output-file eslint_report.json --format json --ext='.js, .jsx, .ts, .tsx' ./src",
    "merge:files": "pnpm mochawesome-merge \"./cypress/reports/mochawesome*.json\" > \"./cypress/reports/index.json\"",
    "prepublishOnly": "pnpm run build",
    "test": "pnpm cross-env NODE_ENV=test CYPRESS_INTERNAL_BROWSER_CONNECT_TIMEOUT=300000 pnpm cypress run --component && pnpm merge:files",
    "test:open": "pnpm cross-env NODE_ENV=test pnpm cypress open --component"
  },
  "peerDependencies": {
    "@emotion/react": ">= 10",
    "@emotion/styled": ">= 10",
    "react": ">= 18",
    "react-dom": ">= 18"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@babel/plugin-syntax-import-assertions": "^7.28.6",
    "@babel/plugin-transform-class-properties": "^7.28.6",
    "@babel/plugin-transform-class-static-block": "^7.28.6",
    "@babel/plugin-transform-typescript": "^7.28.6",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@cypress/code-coverage": "^4.0.0",
    "@emotion/babel-plugin": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@lopatnov/rollup-plugin-uglify": "^3.0.0",
    "@nfq/eslint-config": "^3.3.1",
    "@nfq/eslint-plugin": "^0.8.2",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@stylistic/eslint-plugin-ts": "^4.4.1",
    "@types/cypress__code-coverage": "^3.10.2",
    "@types/node": "^22.19.11",
    "@types/react": "^19.2.14",
    "@types/webpack": "^5.28.5",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "babel-loader": "^10.0.0",
    "babel-plugin-istanbul": "^7.0.1",
    "clean-webpack-plugin": "^4.0.0",
    "cross-env": "^10.1.0",
    "cypress": "^15.10.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-array-func": "^4.0.0",
    "eslint-plugin-better-styled-components": "^1.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^62.5.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-unsanitized": "^4.1.4",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-perf-standard": "^1.0.3",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-hooks-ssr": "^0.1.5",
    "eslint-plugin-redos": "^4.5.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sort-destructure-keys": "^2.0.0",
    "html-webpack-plugin": "^5.6.6",
    "mocha": "^11.7.5",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.1.1",
    "node-polyfill-webpack-plugin": "^4.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rollup": "^4.57.1",
    "rollup-plugin-cleaner": "^1.0.0",
    "rollup-plugin-copy": "^3.5.0",
    "terser": "^5.46.0",
    "typescript": "^5.9.3",
    "webpack": "^5.105.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "5.2.3"
  },
  "standard-version": {
    "scripts": {
      "prebump": "nfqBump"
    }
  },
  "browserslist": [
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "dependencies": {
    "onecolor": "^4.1.0",
    "webskit-gradient-parser": "^1.0.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "cypress"
    ]
  }
}
